    "#Two types\n",
    "#1.Built in function\n",
    "#2.USer-defined function\n",
    "\n",
    "def evenOdd(x):\n",
    "    if x % 2 == 0:  #Check if it is divisible by 2\n",
    "        print(\"even\")\n",
    "\n",
    "    else:\n",
    "        print(\"odd\")\n",
    "\n",
    "evenOdd(2)\n",
    "evenOdd(3)"
